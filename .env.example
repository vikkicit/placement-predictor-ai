# Environment Configuration
APP_ENV=production
ENVIRONMENT=production
APP_NAME=student-placement-mlops
LOG_LEVEL=INFO
DEBUG=false

# Project Configuration Paths
CONFIG_PATH=configs/config.yaml
MODEL_CONFIG_PATH=configs/model_config.yaml

# Directories
DATA_DIR=data
RAW_DATA_DIR=data/raw
INTERIM_DATA_DIR=data/interim
PROCESSED_DATA_DIR=data/processed
ARTIFACT_DIR=artifacts
MODEL_DIR=artifacts/models
PREPROCESSOR_DIR=artifacts/preprocessors
METRICS_DIR=artifacts/metrics
EXPLAINABILITY_DIR=artifacts/explainability
LOGS_DIR=logs

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=student-placement-prediction

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Client Browser Endpoint Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
